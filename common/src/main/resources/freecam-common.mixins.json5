{
  "required": true,
  "package": "net.xolt.freecam.mixins",
  "plugin": "net.xolt.freecam.FreecamMixinConfig",
  "compatibilityLevel": "${mixinCompatLevel}",
  "minVersion": "0.8",
  "mixinextras": {
    "minVersion": "${mixinExtrasMinVersion}"
  },
  "client": [
    "AvatarRendererMixin",
    "BlockStateBaseMixin",
    "CameraMixin",
    "ClientPacketListenerMixin",
    //? if >=1.21.11
    "EnablePlayerOutlineMixin",
    "EntityMixin",
    "EntityRenderDispatcherMixin",
    "FirstPersonHandRotationMixin",
    "FirstPersonHandShadingMixin",
    "FullBrightMixin",
    "GameRendererMixin",
    "GuiMixin",
    //? if >=26.2
    "HudMixin",
    "IrisHandRendererMixin",
    "KeyboardInputMixin",
    "KeyMappingMixin",
    //? if <1.21.6
    //"IrisShadowRendererMixin",
    "LivingEntityMixin",
    "LocalPlayerMixin",
    "MinecraftMixin",
    "MultiPlayerGameModeMixin",
    "OptionsMixin"
  ],
  "injectors": {
    "defaultRequire": 1
  }
}
